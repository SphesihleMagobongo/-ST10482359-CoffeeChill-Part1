                "type": "text/javascript",
                "exec": [
                  "pm.test('Seed item removed or absent (204/404)', function () {",
                  "    pm.expect([204, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/menu/{{category}}/{{sku}}", "host": ["{{baseUrl}}"], "path": ["api", "menu", "{{category}}", "{{sku}}"] }
          },
          "response": []
        },
        {
          "name": "Seed Cleanup - Delete PAS-104 (safe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Seed item removed or absent (204/404)', function () {",
                  "    pm.expect([204, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/menu/Pastries/PAS-104", "host": ["{{baseUrl}}"], "path": ["api", "menu", "Pastries", "PAS-104"] }
          },
          "response": []
        },
        {
          "name": "Create Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response contains id and category', function () {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('sku'));",
                  "    pm.expect(body.category).to.eql(pm.collectionVariables.get('category'));",
                  "});",
                  "pm.collectionVariables.set('createdSku', body.id);",
                  "pm.collectionVariables.set('createdCategory', body.category);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"{{category}}\",\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Espresso\",\n  \"description\": \"Double shot espresso, rich crema\",\n  \"price\": 35.50,\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "response": []
        },
        {
          "name": "Create Second Menu Item (Pastries)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.expect(pm.response.json().id).to.eql('PAS-104');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Pastries\",\n  \"sku\": \"PAS-104\",\n  \"name\": \"Ham & Cheese Croissant\",\n  \"description\": \"Flaky butter croissant with smoked ham and cheddar\",\n  \"price\": 42.00,\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "response": []
        },
        {
          "name": "Create Duplicate Item (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error body has message', function () {",
                  "    pm.expect(pm.response.json().message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"{{category}}\",\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Duplicate Espresso\",\n  \"description\": \"Should be rejected\",\n  \"price\": 30.00,\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "response": []
        },
        {
          "name": "Create Invalid Item (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Validation errors are returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errors).to.be.an('array').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"X\",\n  \"sku\": \"!!!bad sku!!!\",\n  \"name\": \"A\",\n  \"price\": -5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "response": []
        },
        {
          "name": "Get All Menu Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns an array of items', function () {",
                  "    const items = pm.response.json();",
                  "    pm.expect(items).to.be.an('array');",
                  "    pm.expect(items.length).to.be.at.least(2);",
                  "});",
                  "pm.test('Items have expected shape', function () {",
                  "    const first = pm.response.json()[0];",
                  "    pm.expect(first).to.have.all.keys('category', 'id', 'name', 'description', 'price', 'isAvailable', 'lastModified');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "response": []
        },
        {
          "name": "Get Menu Items By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Every item is in the requested category', function () {",
                  "    const cat = pm.collectionVariables.get('createdCategory');",
                  "    pm.response.json().forEach(i => pm.expect(i.category).to.eql(cat));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/menu/category/{{createdCategory}}", "host": ["{{baseUrl}}"], "path": ["api", "menu", "category", "{{createdCategory}}"] }
          },
          "response": []
        },
        {
          "name": "Update Menu Item (price + availability)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Price and availability updated', function () {",
                  "    pm.expect(body.price).to.eql(38.00);",
                  "    pm.expect(body.isAvailable).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 38.00,\n  \"isAvailable\": false\n}"
