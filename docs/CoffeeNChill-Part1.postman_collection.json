    "name": "CoffeeNChill - Part 1 (Menu Tables & Staff Documents)",
    "description": "Verifies every HTTP Azure Function endpoint for the CoffeeNChill canteen system: MenuItems table CRUD and staff-docs document upload/list/download, including negative-path tests. Run against local Azurite (func start) or the standalone Docker container.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:7071" },
    { "key": "sku", "value": "COF-001" },
    { "key": "category", "value": "Hot Drinks" },
    { "key": "createdSku", "value": "" },
    { "key": "createdCategory", "value": "" },
    { "key": "docFileName", "value": "espresso-recipe.txt" }
  ],
  "item": [
    {
      "name": "1. Health & Setup",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service reports Healthy', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('Healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "response": []
        }
      ]
    },
