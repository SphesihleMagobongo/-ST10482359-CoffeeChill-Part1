            "url": { "raw": "{{baseUrl}}/api/menu/Pastries/PAS-104", "host": ["{{baseUrl}}"], "path": ["api", "menu", "Pastries", "PAS-104"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Staff Documents (File Share)",
      "item": [
        {
          "name": "Upload Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Metadata returned (name, size, modified, type)', function () {",
                  "    pm.expect(body).to.have.all.keys('fileName', 'sizeBytes', 'lastModified', 'contentType');",
                  "    pm.expect(body.sizeBytes).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('docFileName', body.fileName);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:/Users/msawa/OneDrive/Documents/CloudPart1(poe)/docs/sample-docs/espresso-recipe.txt",
                  "description": "Select any PDF/TXT/DOCX/MD/XLSX/PPTX/PNG/JPG file. A sample is included in docs/sample-docs/."
                }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/documents/upload", "host": ["{{baseUrl}}"], "path": ["api", "documents", "upload"] }
          },
          "response": []
        },
        {
          "name": "Upload Without File (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/documents/upload", "host": ["{{baseUrl}}"], "path": ["api", "documents", "upload"] }
          },
          "response": []
        },
        {
          "name": "List Staff Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Uploaded document is listed', function () {",
                  "    const name = pm.collectionVariables.get('docFileName');",
                  "    const names = pm.response.json().map(d => d.fileName);",
                  "    pm.expect(names).to.include(name);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api", "documents"] }
          },
          "response": []
        },
        {
          "name": "Download Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Disposition attachment header present', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});",
                  "pm.test('Body is not empty', function () {",
                  "    pm.expect(pm.response.text().length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/documents/download/{{docFileName}}", "host": ["{{baseUrl}}"], "path": ["api", "documents", "download", "{{docFileName}}"] }
          },
          "response": []
