            "url": { "raw": "{{baseUrl}}/api/menu/{{createdCategory}}/{{createdSku}}", "host": ["{{baseUrl}}"], "path": ["api", "menu", "{{createdCategory}}", "{{createdSku}}"] }
          },
          "response": []
